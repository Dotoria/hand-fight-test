# ---------------------------------------------------------------------------
# Assets 아래는 화이트리스트로 관리한다. 기본값이 "추적하지 않음"이므로
# 새 폴더가 생겨도 여기에 명시적으로 추가하지 않는 한 레포에 들어오지 않는다.
# 추적하지 않을 뿐 로컬 파일은 그대로 남으므로 에디터 동작에는 영향 없다.
# ---------------------------------------------------------------------------
/Assets/*
!/Assets/HandFightTest/
!/Assets/HandFightTest.meta
# Unity 2D 템플릿 기본 파일. ProjectSettings가 참조하므로 빼면 깨진 참조가 생긴다
!/Assets/InputSystem_Actions.inputactions
!/Assets/InputSystem_Actions.inputactions.meta

# 평가용 녹화 영상 (용량 큼, 로컬 보관. 영상이 기기 밖으로 나가지 않는다는 설계와도 일관)
/Assets/HandFightTest/EvalClips/

# Unity 생성 폴더
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE / 솔루션 파일 (Unity가 재생성)
.vs/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store
Thumbs.db
desktop.ini

# 빌드 산출물
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
